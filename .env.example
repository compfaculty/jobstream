# Local only. Production startup requires real secrets and private S3 storage.
DEBUG=1
SECRET_KEY=local-development-change-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://jobstream:local-only@localhost:5432/jobstream
REDIS_URL=redis://localhost:6379/0
# Generate: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback/

# Optional AI fact prioritization (opt in per batch; no API calls without both values).
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_TOKEN_BUDGET=200000
AI_MAX_INPUT_CHARACTERS=30000
AI_MAX_OUTPUT_TOKENS=2000
# Font must support all CV characters; defaults to bundled Bitstream Vera.
CV_FONT_PATH=
SEND_PROVIDER_INTERVAL=0.5
SEND_ACCOUNT_INTERVAL=2
SEND_DOMAIN_INTERVAL=5

# Shared interval across all Secret Tel Aviv submissions; 429 extends the cooldown.
SECRET_TLV_APPLY_INTERVAL=10

# Public career collection limits shared across ingestion workers.
CRAWL_GLOBAL_CONCURRENCY=8
CRAWL_HOST_CONCURRENCY=2
CRAWL_HOST_INTERVAL=0
CRAWL_DISPATCH_BATCH=100

# Experimental user-triggered vacancy evaluation (existing AI settings above are independent).
AGENT_BACKEND=disabled
INFINITY_URL=http://127.0.0.1:8091
INFINITY_MODEL=
INFINITY_SERVICE_TOKEN=
INFINITY_TOOL_SECRET=
# Rust process: openai (default) or fake; never enable fake for real evaluation.
INFINITY_PROVIDER=openai
INFINITY_DJANGO_URL=http://127.0.0.1:8000
# Optional restricted PostgreSQL role and infinity_runtime schema; absent = memory only.
INFINITY_DATABASE_URL=
# Optional USD prices; blank means cost is unmeasured, not zero.
INFINITY_INPUT_COST_PER_MILLION=
INFINITY_OUTPUT_COST_PER_MILLION=

# Optional public employer discovery. Enable its campaign in admin separately.
BRAVE_SEARCH_API_KEY=
