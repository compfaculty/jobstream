{
  "uid": "jobstream-investigations",
  "title": "Jobstream \u00b7 Investigations",
  "description": "Restricted operational logs; delayed, duplicated or dropped events are possible. Not an audit store.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "style": "dark",
  "tags": [
    "jobstream",
    "provisioned"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/jobstream-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Django & collection",
      "url": "/d/jobstream-django",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Infinity",
      "url": "/d/jobstream-infinity",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Investigations",
      "url": "/d/jobstream-investigations",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "jobstream-loki"
        },
        "query": "label_values(service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "severity",
        "label": "Severity",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "jobstream-loki"
        },
        "query": "label_values(severity)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "event",
        "type": "custom",
        "query": "http_completed,http_exception,task_started,task_finished,ingestion_completed,provider_call,evaluation_finished,runtime_event",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "correlation",
        "label": "Correlation UUID (optional)",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "INVESTIGATE / FOLLOW THE CHAIN",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Connect the signal to the sequence\nChoose a time range, service and severity. Paste a request, workflow, task, execution or attempt UUID to follow it across services. Logs expire after seven days; missing events may indicate disabled collection, drops or rotation."
      }
    },
    {
      "id": 2,
      "title": "Errors over time",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "jobstream-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by(service)(count_over_time({service=~\"$service\",severity=~\"ERROR|CRITICAL\"}[$__interval]))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Investigate selected scope and time range",
              "url": "/d/jobstream-investigations?${__url_time_range}&${service:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Application log drops",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "jobstream-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by(service,reason)(increase(jobstream_log_dropped_total[$__range]))",
          "refId": "A",
          "legendFormat": "{{service}} \u00b7 {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5794F2",
                "value": null
              }
            ]
          },
          "links": [
            {
              "title": "Investigate selected scope and time range",
              "url": "/d/jobstream-investigations?${__url_time_range}&${service:queryparam}"
            }
          ],
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Live investigation stream",
      "datasource": {
        "type": "loki",
        "uid": "jobstream-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\",severity=~\"$severity\"} | json | event=~\"${event:regex}\" |~ \"${correlation:regex}\"",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "exact"
      }
    },
    {
      "id": 5,
      "title": "Collector drops / rejected lines",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jobstream-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by(service)(increase(loki_write_dropped_entries_total[$__range]))",
          "refId": "A",
          "legendFormat": "{{service}} \u00b7 shipping"
        },
        {
          "refId": "B",
          "expr": "sum by(service)(increase(loki_process_dropped_lines_total[$__range]))",
          "legendFormat": "{{service}} \u00b7 parser/rate limit"
        },
        {
          "refId": "C",
          "expr": "sum by(service)(increase(loki_discarded_samples_total[$__range]))",
          "legendFormat": "{{service}} \u00b7 rejected by Loki"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Investigate selected scope and time range",
              "url": "/d/jobstream-investigations?${__url_time_range}&${service:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "File buffer occupancy",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jobstream-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "jobstream_log_buffer_events{service=~\"$service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Investigate selected scope and time range",
              "url": "/d/jobstream-investigations?${__url_time_range}&${service:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "Monitoring filesystem headroom",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "jobstream-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "min(jobstream_monitoring_disk_available_bytes)",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2147483648
              },
              {
                "color": "#5794F2",
                "value": 4294967296
              }
            ]
          },
          "links": [
            {
              "title": "Investigate selected scope and time range",
              "url": "/d/jobstream-investigations?${__url_time_range}&${service:queryparam}"
            }
          ],
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto"
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Recent failures",
      "datasource": {
        "type": "loki",
        "uid": "jobstream-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\",severity=~\"ERROR|CRITICAL\"}",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "exact"
      }
    }
  ]
}
