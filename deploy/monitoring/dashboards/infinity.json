  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "INFINITY / REASONING RUNTIME",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Evaluation health without private content\nOnly known token usage is counted. No prompts, CVs, response bodies or monetary estimates. A disabled runtime displays **Unavailable**."
      }
    },
    {
      "id": 2,
      "title": "Runtime reachable",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "jobstream-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"infinity\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5794F2",
                "value": null
              }
            ]
          },
          "links": [
            {
              "title": "Investigate selected scope and time range",
              "url": "/d/jobstream-investigations?${__url_time_range}&var-service=infinity"
            }
          ],
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto"
      }
    },
