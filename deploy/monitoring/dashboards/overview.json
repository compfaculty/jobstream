{
  "uid": "jobstream-overview",
  "title": "Jobstream \u00b7 Mission control",
  "description": "Application health, collection progress and worker capacity. Payload charts show observed bodies, not network traffic.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "style": "dark",
  "tags": [
    "jobstream",
    "provisioned"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/jobstream-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Django & collection",
      "url": "/d/jobstream-django",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Infinity",
      "url": "/d/jobstream-infinity",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Investigations",
      "url": "/d/jobstream-investigations",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jobstream-prometheus"
        },
        "query": "label_values(up, service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "queue",
        "label": "Queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jobstream-prometheus"
        },
        "query": "label_values(jobstream_queue_depth, queue)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "JOBSTREAM / MISSION CONTROL",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### A clear view of the pipeline\nRequests \u2192 collection \u2192 evaluation \u2192 preparation \u2192 approved delivery. **Gaps mean unavailable telemetry**, not zero activity. Local alerts have no external receiver."
      }
    },
    {
      "id": 2,
      "title": "Target availability",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "jobstream-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(up{job=~\"jobstream|infinity\",service=~\"$service\"}) / count(up{job=~\"jobstream|infinity\",service=~\"$service\"})",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Investigate selected scope and time range",
              "url": "/d/jobstream-investigations?${__url_time_range}&${service:queryparam}"
            }
          ],
          "noValue": "Unavailable",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "Snapshot age",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "jobstream-prometheus"
