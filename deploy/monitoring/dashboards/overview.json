      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(time() - jobstream_snapshot_timestamp_seconds) and jobstream_snapshot_present == 1",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
