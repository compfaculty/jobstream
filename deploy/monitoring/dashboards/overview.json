      "targets": [
        {
          "expr": "sum by(service) (rate(jobstream_http_requests_total{route!=\"health\",service=~\"$service\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
