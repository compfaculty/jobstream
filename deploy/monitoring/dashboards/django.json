{
  "uid": "jobstream-django",
  "title": "Jobstream \u00b7 Django & collection",
  "description": "HTTP, outbound bodies, collection providers and Celery task attempts.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "style": "dark",
  "tags": [
    "jobstream",
    "provisioned"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "url": "/d/jobstream-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Django & collection",
      "url": "/d/jobstream-django",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Infinity",
      "url": "/d/jobstream-infinity",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Investigations",
      "url": "/d/jobstream-investigations",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jobstream-prometheus"
        },
        "query": "label_values(up, service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "queue",
        "label": "Queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jobstream-prometheus"
        },
        "query": "label_values(jobstream_queue_depth, queue)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jobstream-prometheus"
        },
        "query": "label_values(jobstream_outbound_attempts_total, provider)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jobstream-prometheus"
        },
        "query": "label_values(jobstream_http_requests_total, route)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "APPLICATION / COLLECTION",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### From request to completed work\nFilter routes, providers and queues. Liveness probes are separate. Retries are task attempt outcomes; body bytes exclude SMTP and browser-managed traffic."
      }
    },
    {
      "id": 2,
      "title": "Route throughput",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jobstream-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(route,status)(rate(jobstream_http_requests_total{route=~\"$route\",route!=\"health\",service=~\"$service\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{route}} \u00b7 {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 14,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Investigate selected scope and time range",
              "url": "/d/jobstream-investigations?${__url_time_range}&${service:queryparam}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
